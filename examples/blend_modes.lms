out = ARGV.len() > 0 ? ARGV[0] : "blend_modes.dslb";
mkdir("images");
p = _dsl_ cli="lmimg" install="github:lmctl-ai/lmimg@latest";
let before = img.pattern(420, 480, "0.1", "y", "0.8", "1");
let over = img.pattern(300, 300, "x", "0.2", "1-x", "0.75");
let after = before.copy().blend(over, "screen", 0.8, 70, 90);
before.text(20.0, 35.0, "BASE", 22.0, 1.0, 1.0, 1.0, 1.0);
after.text(20.0, 35.0, "SCREEN", 22.0, 1.0, 1.0, 1.0, 1.0);
let im = img.panel(before, after, 20);
img.assert_true(im.width() == 900);
img.assert_true(after.mean(0) > before.mean(0));
im.save("images/blend_modes.png");
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
assert(r.code == 0);

print("images/blend_modes.png");
