out = ARGV.len() > 0 ? ARGV[0] : "contact_sheet_story.dslb";
mkdir("images");
p = _dsl_ cli="lmimg" install="github:lmctl-ai/lmimg@latest";
let a = img.pattern(210, 240, "0.18 + 0.62*x", "0.12 + 0.50*y", "0.76", "1");
a.circle(105.0, 122.0, 64.0, 0.96, 0.34, 0.22, 1.0);
a.text(12.0, 30.0, "WARM", 16.0, 1.0, 1.0, 1.0, 1.0);
let b = img.pattern(210, 240, "0.70", "0.16 + 0.62*x", "0.18 + 0.52*y", "1");
b.circle(105.0, 122.0, 64.0, 0.22, 0.86, 0.72, 1.0);
b.text(12.0, 30.0, "COOL", 16.0, 1.0, 1.0, 1.0, 1.0);
let c = img.pattern(210, 240, "0.12 + 0.50*y", "0.72", "0.20 + 0.54*x", "1");
c.circle(105.0, 122.0, 64.0, 0.98, 0.74, 0.22, 1.0);
c.text(12.0, 30.0, "GOLD", 16.0, 1.0, 1.0, 1.0, 1.0);
let d = img.pattern(210, 240, "0.20 + 0.52*x", "0.18 + 0.52*y", "0.76", "1");
d.circle(105.0, 122.0, 64.0, 0.56, 0.28, 0.96, 1.0);
d.text(12.0, 30.0, "VIOLET", 16.0, 1.0, 1.0, 1.0, 1.0);
let top = img.panel(a, b, 14);
let bottom = img.panel(c, d, 14);
let sheet = img.panel(top, bottom, 14);
sheet.resize(900, 520);
sheet.save("images/contact_sheet_story.png");
img.assert_true(sheet.width() == 900);
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
assert(r.code == 0);
print("images/contact_sheet_story.png");
