out = ARGV.len() > 0 ? ARGV[0] : "edge_map.dslb";
mkdir("images");
p = _dsl_ cli="lmimg" install="github:lmctl-ai/lmimg@latest";
let before = img.pattern(420, 480, "x", "y", "0.5", "1");
let after = before.copy().edges(2.0).grayscale();
before.text(20.0, 35.0, "FIELD", 22.0, 1.0, 1.0, 1.0, 1.0);
after.text(20.0, 35.0, "EDGES", 22.0, 1.0, 1.0, 1.0, 1.0);
let im = img.panel(before, after, 20);
img.assert_true(im.width() == 900);
img.assert_true(im.height() == 520);
im.save("images/edge_map.png");
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
assert(r.code == 0);
