out = ARGV.len() > 0 ? ARGV[0] : "levels_lab.dslb";
mkdir("images");
p = _dsl_ cli="lmimg" install="github:lmctl-ai/lmimg@latest";
let before = img.pattern(420, 480, "0.1 + 0.8*x", "0.1 + 0.8*x", "0.1 + 0.8*x", "1");
let after = before.copy().levels(0.1, 0.85, 0.9);
before.text(20.0, 35.0, "LINEAR", 22.0, 0.0, 0.0, 0.0, 1.0);
after.text(20.0, 35.0, "GAMMA", 22.0, 0.0, 0.0, 0.0, 1.0);
let im = img.panel(before, after, 20);
img.assert_true(im.height() == 480);
img.assert_true(after.mean(0) > 0.0);
im.save("images/levels_lab.png");
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
assert(r.code == 0);
