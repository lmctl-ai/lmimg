out = ARGV.len() > 0 ? ARGV[0] : "gradient_studio.dslb";
mkdir("images");
p = _dsl_ cli="lmimg" install="github:lmctl-ai/lmimg@latest";
let before = img.canvas(420, 480, 0.08, 0.10, 0.18, 1.0);
before.rect(40.0, 80.0, 100.0, 280.0, 0.94, 0.20, 0.20, 1.0);
before.rect(160.0, 80.0, 100.0, 280.0, 0.20, 0.82, 0.42, 1.0);
before.rect(280.0, 80.0, 100.0, 280.0, 0.24, 0.42, 0.96, 1.0);
let after = before.copy().levels(0.15, 0.85, 0.9);
before.text(20.0, 35.0, "BEFORE", 22.0, 1.0, 1.0, 1.0, 1.0);
after.text(20.0, 35.0, "LEVELS", 22.0, 1.0, 1.0, 1.0, 1.0);
let im = img.panel(before, after, 20);
img.assert_true(im.width() == 900);
img.assert_true(im.height() == 520);
im.save("images/gradient_studio.png");
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
assert(r.code == 0);
