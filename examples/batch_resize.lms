out = ARGV.len() > 0 ? ARGV[0] : "batch_resize.dslb";
mkdir("images");
p = _lmcode_ cli="lmimg" install="github:lmctl-ai/lmimg@latest";
let source = img.pattern(240, 320, "0.12 + 0.52*x", "0.18 + 0.46*y", "0.72 - 0.34*x", "1");
source.circle(120.0, 150.0, 70.0, 0.96, 0.72, 0.24, 1.0);
source.rect(42.0, 234.0, 156.0, 26.0, 0.12, 0.20, 0.48, 1.0);
let small = img.canvas(280, 460, 0.97, 0.97, 0.95, 1.0);
let small_image = source.copy().resize(180, 240);
small_image.save("images/batch_small.png");
img.assert_true(small_image.width() == 180 && small_image.height() == 240);
small.blend(small_image, "over", 1.0, 50, 82);
small.text(18.0, 42.0, "SMALL 180x240", 20.0, 0.08, 0.10, 0.18, 1.0);
let medium = img.canvas(280, 460, 0.97, 0.97, 0.95, 1.0);
let medium_image = source.copy().resize(210, 280);
medium_image.save("images/batch_medium.png");
img.assert_true(medium_image.width() == 210 && medium_image.height() == 280);
medium.blend(medium_image, "over", 1.0, 35, 82);
medium.text(18.0, 42.0, "MEDIUM 210x280", 20.0, 0.08, 0.10, 0.18, 1.0);
let large = img.canvas(280, 460, 0.97, 0.97, 0.95, 1.0);
let large_image = source.copy().resize(240, 320);
large_image.save("images/batch_large.png");
img.assert_true(large_image.width() == 240 && large_image.height() == 320);
large.blend(large_image, "over", 1.0, 20, 82);
large.text(18.0, 42.0, "LARGE 240x320", 20.0, 0.08, 0.10, 0.18, 1.0);
let triptych = img.montage().add(small).add(medium).add(large).render(3, 10, 0.97, 0.97, 0.95, 1.0);
let board = img.canvas(900, 520, 1.0, 1.0, 1.0, 1.0);
board.blend(triptych, "over", 1.0, 10, 20);
board.save("images/batch_resize.png");
img.assert_true(board.width() == 900 && board.height() == 520);
end _lmcode_
savedsl(p, out);
r = system ${dsl_cli(p)} --lmcode ${out};
assert(r.code == 0);
print("images/batch_resize.png");
print("images/batch_small.png");
print("images/batch_medium.png");
print("images/batch_large.png");
