out = ARGV.len() > 0 ? ARGV[0] : "batch_resize.dslb";
mkdir("images");
p = _dsl_ cli="lmimg" install="github:lmctl-ai/lmimg@latest";
let source = img.pattern(240, 320, "0.12 + 0.52*x", "0.18 + 0.46*y", "0.72 - 0.34*x", "1");
source.circle(120.0, 150.0, 70.0, 0.96, 0.72, 0.24, 1.0);
source.rect(42.0, 234.0, 156.0, 26.0, 0.12, 0.20, 0.48, 1.0);
let small = img.canvas(280, 460, 0.97, 0.97, 0.95, 1.0);
small.blend(source.copy().resize(180, 240), "over", 1.0, 50, 82);
small.text(18.0, 42.0, "SMALL 180x240", 16.0, 0.08, 0.10, 0.18, 1.0);
let medium = img.canvas(280, 460, 0.97, 0.97, 0.95, 1.0);
medium.blend(source.copy().resize(210, 280), "over", 1.0, 35, 82);
medium.text(18.0, 42.0, "MEDIUM 210x280", 16.0, 0.08, 0.10, 0.18, 1.0);
let large = img.canvas(280, 460, 0.97, 0.97, 0.95, 1.0);
large.blend(source.copy().resize(240, 320), "over", 1.0, 20, 82);
large.text(18.0, 42.0, "LARGE 240x320", 16.0, 0.08, 0.10, 0.18, 1.0);
let pair = img.panel(small, medium, 18);
let triptych = img.panel(pair, large, 18);
triptych.resize(900, 520);
triptych.save("images/batch_resize.png");
img.assert_true(triptych.width() == 900);
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
assert(r.code == 0);
print("images/batch_resize.png");
