mkdir("images");
p = _lmcode_ cli="lmimg" install="github:lmctl-ai/lmimg@latest";
let a = img.pattern(420, 480, "x", "y", "0.2", "1");
let b = img.pattern(420, 480, "0.8", "x", "y", "1");
let im = img.panel(a, b, 20);
img.assert_true(im.width() == 900);
im.text(38.0, 54.0, "PROCEDURAL PANEL", 22.0, 1.0, 1.0, 1.0, 1.0);
im.save("images/thumbnail_grid.png");
end _lmcode_
r = run_lmcode(p);
assert(r.ok);

print("images/thumbnail_grid.png");
