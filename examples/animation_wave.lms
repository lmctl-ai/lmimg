out = ARGV.len() > 0 ? ARGV[0] : "animation_wave.dslb";
mkdir("images");
p = _lmcode_ cli="lmimg" install="github:lmctl-ai/lmimg@latest";
let anim = img.animation();
for (k in range(0, 8)) {
  let frame = img.canvas(640, 360, 0.05, 0.08, 0.15, 1.0);
  frame.circle(60.0 + float(k) * 75.0, 180.0, 38.0, 0.2, 0.7, 1.0, 1.0);
  anim.add(frame, 8);
}
img.assert_true(anim.size() == 8);
let preview = img.canvas(900, 520, 0.05, 0.08, 0.15, 1.0);
preview.circle(320.0, 260.0, 100.0, 0.2, 0.7, 1.0, 1.0);
preview.text(25.0, 45.0, "EIGHT FRAME MOTION", 28.0, 1.0, 1.0, 1.0, 1.0);
preview.save("images/animation_wave.png");
anim.save("images/animation_wave.gif");
end _lmcode_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
assert(r.code == 0);

print("images/animation_wave.png");
print("images/animation_wave.gif");
