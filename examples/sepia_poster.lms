out = ARGV.len() > 0 ? ARGV[0] : "sepia_poster.dslb";
mkdir("images");
p = _dsl_ cli="lmimg" install="github:lmctl-ai/lmimg@latest";
let before = img.pattern(420, 480, "0.15 + 0.7*x", "0.1 + 0.6*y", "0.3", "1");
let after = before.copy().sepia(80.0);
before.text(20.0, 35.0, "COLOR", 22.0, 1.0, 1.0, 1.0, 1.0);
after.text(20.0, 35.0, "SEPIA", 22.0, 1.0, 1.0, 1.0, 1.0);
let im = img.panel(before, after, 20);
img.assert_true(im.width() == 900);
img.assert_true(im.height() == 520);
im.save("images/sepia_poster.png");
end _dsl_
savedsl(p, out);
r = system ${dsl_cli(p)} --dsl ${out};
assert(r.code == 0);
