out = ARGV.len() > 0 ? ARGV[0] : "sepia_poster.dslb";
mkdir("images");
p = _lmcode_ cli="lmimg" install="github:lmctl-ai/lmimg@latest";
let before = img.canvas(420, 480, 0.12, 0.08, 0.18, 1.0);
before.circle(210.0, 190.0, 120.0, 0.84, 0.22, 0.32, 1.0);
before.circle(210.0, 190.0, 70.0, 0.96, 0.68, 0.22, 1.0);
before.rect(70.0, 330.0, 280.0, 38.0, 0.32, 0.80, 0.88, 1.0);
let after = before.copy().sepia(80.0);
before.text(20.0, 35.0, "COLOR", 22.0, 1.0, 1.0, 1.0, 1.0);
after.text(20.0, 35.0, "SEPIA", 22.0, 1.0, 1.0, 1.0, 1.0);
let im = img.panel(before, after, 20);
img.assert_true(im.width() == 900);
img.assert_true(im.height() == 520);
im.save("images/sepia_poster.png");
end _lmcode_
savedsl(p, out);
r = system ${dsl_cli(p)} --lmcode ${out};
assert(r.code == 0);

print("images/sepia_poster.png");
