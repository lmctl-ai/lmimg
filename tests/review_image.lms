p = _dsl_ cli="lmimg" install="github:lmctl-ai/lmimg@latest";
let row=img.canvas(9,1,0.0,0.0,0.0,1.0);
row.set_pixel(4,0,1.0,1.0,1.0,1.0).tilt_shift(2.0,0.0,1.0);
img.assert_close(row.pixel(4,0,0),1.0,0.004);
let one=img.canvas(1,1,0.5,0.25,0.75,1.0);
one.vignette(0.0,0.0).unsharp(1.0,1.0,1.0,0.0).morphology("median",1);
img.assert_true(one.pixel(0,0,0)>=0.0 && one.pixel(0,0,0)<=1.0);
let base=img.canvas(1,1,0.2,0.4,0.6,1.0);
let top=img.canvas(1,1,0.6,0.3,0.2,1.0);
let overlay=base.copy().blend(top,"overlay",1.0,0,0);
let difference=base.copy().blend(top,"difference",1.0,0,0);
let darken=base.copy().blend(top,"darken",1.0,0,0);
let lighten=base.copy().blend(top,"lighten",1.0,0,0);
let addition=base.copy().blend(top,"addition",1.0,0,0);
let subtract=base.copy().blend(top,"subtract",1.0,0,0);
img.assert_close(overlay.pixel(0,0,0),0.24,0.01);
img.assert_close(difference.pixel(0,0,0),0.4,0.01);
img.assert_close(darken.pixel(0,0,0),0.2,0.01);
img.assert_close(lighten.pixel(0,0,0),0.6,0.01);
img.assert_close(addition.pixel(0,0,0),0.8,0.01);
img.assert_close(subtract.pixel(0,0,0),0.0,0.01);
let layers=img.layers(1,1).add(base,"over",1.0,0,0).add(top,"overlay",1.0,0,0).render();
img.assert_close(layers.pixel(0,0,0),0.24,0.01);
end _dsl_
out=ARGV.len()>0 ? ARGV[0] : "review_image.dslb";
savedsl(p,out);
