p = _dsl_ cli="lmimg" install="github:lmctl-ai/lmimg@latest";
# Closed-form answers for the v0.1.2 operations.
let ramp = img.canvas(3, 1, 0.0, 0.0, 0.0, 1.0);
ramp.set_pixel(0, 0, 0.2, 0.2, 0.2, 1.0).set_pixel(1, 0, 0.5, 0.5, 0.5, 1.0).set_pixel(2, 0, 0.8, 0.8, 0.8, 1.0);
let thr = ramp.copy().threshold(0.5);
img.assert_close(thr.pixel(0, 0, 0), 0.0, 0.000001);
img.assert_close(thr.pixel(1, 0, 0), 1.0, 0.000001);
img.assert_close(ramp.copy().invert().pixel(2, 0, 1), 0.2, 0.004);
let norm = ramp.copy().normalize();
img.assert_close(norm.pixel(0, 0, 0), 0.0, 0.000001);
img.assert_close(norm.pixel(1, 0, 0), 0.5, 0.004);
img.assert_close(norm.pixel(2, 0, 0), 1.0, 0.000001);
let eq = img.canvas(4, 1, 0.1, 0.1, 0.1, 1.0);
eq.set_pixel(2, 0, 0.3, 0.3, 0.3, 1.0).set_pixel(3, 0, 0.9, 0.9, 0.9, 1.0);
eq.equalize();
img.assert_close(eq.pixel(0, 0, 0), 0.0, 0.000001);
img.assert_close(eq.pixel(2, 0, 0), 0.5, 0.004);
img.assert_close(eq.pixel(3, 0, 0), 1.0, 0.000001);
let heat = ramp.copy().colormap("heat");
img.assert_close(heat.pixel(2, 0, 0), 1.0, 0.004);
img.assert_true(heat.pixel(0, 0, 0) > heat.pixel(0, 0, 2));
let cr = img.curve().point(0.0, 0.0).point(1.0, 1.0);
let cg = img.curve().point(0.0, 0.0).point(0.5, 0.9).point(1.0, 1.0);
let cb = img.curve().point(0.0, 1.0).point(1.0, 0.0);
let mid = img.canvas(1, 1, 0.5, 0.5, 0.5, 1.0).curves_rgb(cr, cg, cb);
img.assert_close(mid.pixel(0, 0, 0), 0.5, 0.004);
img.assert_close(mid.pixel(0, 0, 1), 0.9, 0.004);
img.assert_close(mid.pixel(0, 0, 2), 0.5, 0.004);
let hald = img.hald(4);
img.assert_true(hald.width() == 64 && hald.height() == 64);
let probe = img.pattern(12, 4, "x", "y", "0.5+0.5*x", "1");
img.assert_true(probe.copy().clut(hald).psnr(probe) > 60.0);
let direct = probe.copy().curves_rgb(cg, cb, cr).hsl(30.0, 1.2, 1.0);
let via = probe.copy().clut(hald.copy().curves_rgb(cg, cb, cr).hsl(30.0, 1.2, 1.0));
img.assert_true(via.psnr(direct) > 40.0);
let q = img.canvas(1, 1, 0.25, 0.5, 0.0, 1.0).blend(img.canvas(1, 1, 0.5, 0.5, 0.0, 1.0), "divide", 1.0, 0, 0);
img.assert_close(q.pixel(0, 0, 0), 0.5, 0.004);
img.assert_close(q.pixel(0, 0, 1), 1.0, 0.004);
img.assert_close(q.pixel(0, 0, 2), 1.0, 0.004);
let w1 = img.text_width("Hello", 32.0);
img.assert_true(w1 > 40.0 && w1 < 120.0);
img.assert_close(img.text_width("HelloHello", 32.0), 2.0 * w1, 0.000001);
img.assert_close(img.text_width("Hello\nHi", 32.0), w1, 0.000001);
let glow = img.canvas(21, 21, 0.0, 0.0, 0.0, 0.0);
glow.rect(8.0, 8.0, 4.0, 4.0, 1.0, 0.0, 0.0, 1.0);
img.assert_close(glow.pixel(8, 10, 0), 1.0, 0.000001);
glow.blur(0.0, 1.5);
img.assert_true(glow.pixel(10, 10, 3) < 0.95 && glow.pixel(7, 10, 3) > 0.1);
img.assert_close(glow.pixel(7, 10, 0), 1.0, 0.004);
img.assert_close(glow.pixel(2, 10, 3), 0.0, 0.000001);
let n1 = img.pattern(16, 16, "hash(x,y,7)", "noise(5*x,5*y,2)", "0", "1");
let n2 = img.pattern(16, 16, "hash(x,y,7)", "noise(5*x,5*y,2)", "0", "1");
img.assert_true(n1.psnr(n2) > 1000.0);
img.assert_true(n1.stddev(0) > 0.2 && n1.min(1) >= 0.0 && n1.max(1) <= 1.0);
end _dsl_
out = ARGV.len() > 0 ? ARGV[0] : "oracles.dslb";
savedsl(p, out);
